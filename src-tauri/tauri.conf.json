{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cc-deskmeter",
  "version": "0.5.5",
  "identifier": "com.claudepulse.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CC-Deskmeter",
        "width": 1314,
        "height": 850,
        "minWidth": 960,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "backgroundColor": "#141413"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://127.0.0.1:1420",
        "script-src": "'self' 'unsafe-inline' http://127.0.0.1:1420",
        "style-src": "'self' 'unsafe-inline' http://127.0.0.1:1420",
        "img-src": "'self' data: blob: http://127.0.0.1:1420",
        "font-src": "'self' data: http://127.0.0.1:1420",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420 ws://127.0.0.1:1421",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "windows": {
      "nsis": {
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true
      }
    },
    "linux": {
      "deb": {
        "conflicts": ["claude-pulse"],
        "replaces": ["claude-pulse"]
      },
      "rpm": {
        "obsoletes": ["claude-pulse"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
